# Sentinel — example environment (copy to .env and fill in).
# NEVER commit a real .env — it is gitignored. If a real SECRET_KEY or
# GITHUB_CLIENT_SECRET was ever pasted/shared, rotate both immediately
# (rotating SECRET_KEY invalidates Fernet-encrypted GitHub tokens, so users
# reconnect GitHub once).
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-string
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@postgres:5432/sentinel_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/github/callback
WORKSPACE_ROOT=/tmp/sentinel-workspaces
CLONE_TIMEOUT_SECONDS=120
SCANNER_TIMEOUT_SECONDS=600
MAX_REPO_SIZE_MB=500
ALLOWED_GIT_HOSTS=github.com,gitlab.com
ENABLED_SCANNERS=semgrep,bandit,trivy,gitleaks
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
AI_MAX_FINDINGS_PER_SCAN=25
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
